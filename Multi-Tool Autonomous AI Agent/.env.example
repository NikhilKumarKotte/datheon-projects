# ==============================================================================
# Multi-Tool Autonomous AI Agent Configuration
# ==============================================================================

# LLM Provider Configuration
# Supported providers: "openai", "google", "ollama", "mock"
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# API Keys (Provide the one corresponding to your chosen LLM_PROVIDER)
# For OpenAI:
OPENAI_API_KEY=your_openai_api_key_here

# For Google Gemini (if using LLM_PROVIDER=google):
GOOGLE_API_KEY=your_google_api_key_here

# For Ollama / Local LLM (if using LLM_PROVIDER=ollama):
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Tool Configuration
# DuckDuckGo Search needs no API key (works out-of-the-box).
# Tavily Search (optional - if provided, enables enhanced web search):
TAVILY_API_KEY=

# Local File Reader Configuration
# Base directory for the file reader tool (defaults to current working directory)
FILE_READER_BASE_DIR=.
# Maximum file size allowed to be read in bytes (default: 1MB = 1048576)
MAX_FILE_READ_BYTES=1048576

# Agent Execution Settings
MAX_ITERATIONS=10
VERBOSE_OUTPUT=true
