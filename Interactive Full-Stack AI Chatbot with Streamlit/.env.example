# ========================================================
# Interactive AI Chatbot Environment Configuration
# ========================================================

# --- LLM API Keys (Set at least one or input via the UI) ---
GOOGLE_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# --- Default Model Settings ---
DEFAULT_PROVIDER=google
DEFAULT_MODEL=gemini-2.5-flash
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=2048

# --- Online Database Configuration ---
# Leave blank for default local SQLite database (./data/chat_history.db)
# Or provide your online cloud database URL (e.g. Supabase, Neon, AWS RDS, PostgreSQL):
# Examples:
# DATABASE_URL=postgresql+psycopg://postgres:password@db.xyz.supabase.co:5432/postgres
# DATABASE_URL=postgresql+psycopg://username:password@ep-cool-fog-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Application Customization ---
APP_NAME="OmniStream AI"
APP_DESCRIPTION="Interactive Full-Stack AI Chatbot with Streaming & RAG"
DEFAULT_THEME="midnight"
