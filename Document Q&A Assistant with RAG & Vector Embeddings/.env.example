# =====================================================================
# Document Q&A Assistant Configuration
# =====================================================================

# Vector Store Selection: 'chroma' or 'faiss'
RAG_VECTOR_STORE=chroma

# Chunking Hyperparameters
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=100

# Embedding Provider: 'huggingface' (Free & Offline), 'openai', or 'gemini'
RAG_EMBEDDING_PROVIDER=huggingface
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LLM Provider: 'local' (Free & Offline), 'openai', 'gemini', or 'groq'
RAG_LLM_PROVIDER=local
RAG_LLM_MODEL=gpt-4o-mini
RAG_LLM_TEMPERATURE=0.0

# Retrieval Parameters
RAG_TOP_K=4
RAG_SCORE_THRESHOLD=0.2

# ---------------------------------------------------------------------
# Cloud Provider API Keys (Optional - only required if not using 'local')
# ---------------------------------------------------------------------
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
