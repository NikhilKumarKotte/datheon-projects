# -----------------------------------------------------------------------------
# Structured LLM Extractor Configuration
# -----------------------------------------------------------------------------

# Google Gemini API key (Required)
# Obtain your key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Default model to use for extraction
DEFAULT_MODEL=gemini-3.5-flash-lite

# Fallback models attempted if primary encounters high demand (comma-delimited in lists)
FALLBACK_MODELS=["gemini-3.8-flash", "gemini-flash-latest"]

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
